# Reactor — world model. Server-only. Exchanged for a short-lived JWT at /api/reactor/token.
# Never expose this key to the browser.
REACTOR_API_KEY=rk_your_key_here

# OpenAI — fear profile inference (structured outputs), seed image, and
# psychologist TTS regeneration (scripts/generate-assets.mjs). Server-only.
OPENAI_API_KEY=sk-your_key_here

# Public origin the world model can reach to fetch the seed frame. In dev,
# run a quick tunnel (e.g. untun/cloudflared) pointed at localhost:3000 and
# put its URL here.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
