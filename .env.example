# Reactor — world model. Server-only. Exchanged for a short-lived JWT at /api/reactor/token.
# Never expose this key to the browser.
REACTOR_API_KEY=rk_your_key_here

# OpenAI — fear profile inference (structured outputs) + seed image bytes.
# Server-only.
OPENAI_API_KEY=sk-your_key_here

# Vercel Blob — hosts the generated seed frame at a public URL the world model
# fetches server-side. Injected by `vercel blob create-store`; pull it locally
# with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# fal.ai — only used by the OpenEdit lipsync/background tools, not at runtime.
FAL_KEY=your_key_here

# Runware — psychologist TTS regeneration (scripts/generate-assets.mjs) and the
# /api/tts route. Optional at runtime: committed audio files cover the demo.
RUNWARE_API_KEY=your_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to veed only after installing all clips in public/video/psychologist-landscape/.
NEXT_PUBLIC_INTERVIEW_MODE=audio
