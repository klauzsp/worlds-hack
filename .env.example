# Reactor — world model. Server-only. Exchanged for a short-lived JWT at /api/reactor/token.
# Never expose this key to the browser.
REACTOR_API_KEY=rk_your_key_here

# OpenAI — fear profile inference (structured outputs) + seed image. Server-only.
OPENAI_API_KEY=sk-your_key_here

# Runware — psychologist TTS regeneration (scripts/generate-assets.mjs) and the
# /api/tts route. Optional at runtime: committed audio files cover the demo.
RUNWARE_API_KEY=your_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
